cat > .gitignore << 'EOF'
# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/

# Data — only the top-level data folder
/data/

# Large binary artifacts
*.tfrecord
*.pt
*.pth
*.tar
*.gif
scripts/*.png

# IDE
.idea/
.vscode/

# OS
.DS_Store

# Experiments
outputs/
runs/
wandb/
checkpoints/
EOFlogs/
outputs_archive/
outputs_smoke/
*.save
artifacts/
*.bak3
.venv/
data/
outputs/
outputs_archive/
outputs_smoke/
artifacts/
rollouts/
logs/
wandb/
*.ckpt
*.pt
*.npz
*.part
__pycache__/
*.egg-info/
*.bak
