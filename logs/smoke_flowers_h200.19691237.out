CUDA: True
Device: NVIDIA H200
data:
  name: cylinder
  root: data/cylinder_flow
  norm_stats_path: data/cylinder_flow/torch/norm_stats.pt
  batch_size: 8
  num_workers: 4
  train_in_memory: true
  valid_in_memory: true
  test_in_memory: true
  max_train_trajectories: 50
  max_valid_trajectories: 10
  max_test_trajectories: null
  train_noise_std: 0.02
  train_noise_gamma: 1.0
model:
  name: flowers_mesh
  net:
    _target_: flowers_gnn.models.flowers_mesh.FlowersMesh
    latent_dim: 192
    num_blocks: 8
    num_heads: 8
    k_interp: 3
train:
  epochs: 3
  optimizer:
    _target_: torch.optim.AdamW
    lr: 0.0001
    weight_decay: 0.0001
  lr_scheduler:
    warmup_epochs: 1
    eta_min_factor: 0.1
  rollout:
    horizons:
    - 1
    - 10
    - 20
    - 50
    - 100
    - 200
    max_trajectories: 5
    eval_every_n_epochs: 1
  checkpoint:
    save_every_n_epochs: 1
    keep_last: 3
resume_from: null
experiment:
  name: ${model.name}_${data.name}
  seed: 42
  project: flowers-gn
  wandb_mode: disabled
device: auto
output_dir: outputs/${experiment.name}_${now:%Y%m%d_%H%M%S}

Using device: cuda
