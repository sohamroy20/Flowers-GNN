data:
  name: cylinder
  root: data/cylinder_flow
  norm_stats_path: data/cylinder_flow/torch/norm_stats.pt
  batch_size: 8
  num_workers: 4
  train_in_memory: true
  valid_in_memory: true
  test_in_memory: true
  max_train_trajectories: null
  max_valid_trajectories: null
  max_test_trajectories: null
  train_noise_std: 0.02
  train_noise_gamma: 1.0
model:
  name: mgn
  net:
    _target_: flowers_gnn.models.mgn.MGN
    latent_size: 128
    num_mp_steps: 15
train:
  epochs: 50
  optimizer:
    _target_: torch.optim.AdamW
    lr: 0.0001
    weight_decay: 0.0001
  lr_scheduler:
    warmup_epochs: 1
    eta_min_factor: 0.1
