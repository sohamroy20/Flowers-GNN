    horizons:
    - 1
    - 10
    - 20
    - 50
    - 100
    - 200
    max_trajectories: 32
    eval_every_n_epochs: 1
  checkpoint:
    save_every_n_epochs: 1
    keep_last: 3
resume_from: null
experiment:
  name: ${model.name}_${data.name}
  seed: 42
  project: flowers-gn
  wandb_mode: online
device: auto
output_dir: outputs/${experiment.name}_${now:%Y%m%d_%H%M%S}

